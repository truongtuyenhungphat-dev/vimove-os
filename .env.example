# Database (local dev: docker compose up -d)
DATABASE_URL="postgresql://vimove:vimove@localhost:5437/vimove_os?schema=public"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google Workspace SSO (đăng nhập) — KHÁC với GOOGLE_ADS_* bên dưới (đó là Google Ads API).
# Tạo tại https://console.cloud.google.com/apis/credentials — OAuth Client ID, loại "Web application",
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (dev) và
# https://<domain-that>/api/auth/callback/google (production).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Tuỳ chọn: chỉ cho phép đăng nhập Google từ đúng domain Workspace của công ty (Google "hd" claim).
GOOGLE_WORKSPACE_DOMAIN=

# AI Command Center (Phase 8+)
ANTHROPIC_API_KEY=

# Ads Integration (Phase 6+)
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=

# Credential/token encryption (Phase 6+)
ENCRYPTION_KEY=

# Background jobs (Phase 3+)
REDIS_URL=
CRON_SECRET=

# File storage
BLOB_READ_WRITE_TOKEN=

# Javis OS integration — MCP server tại /api/mcp/javis, đấu vào Javis OS qua
# "Kết nối > Tự thêm (nâng cao)" (transport http, header Authorization: Bearer <key>).
# JAVIS_MCP_API_KEY: sinh bằng `openssl rand -hex 32`, coi như mật khẩu — không để trống khi deploy.
JAVIS_MCP_API_KEY=
# true = Javis tạo/sửa được đơn hàng, bảo hành, khách hàng thật. false = chỉ đọc.
JAVIS_MCP_ALLOW_WRITE=true
# User hệ thống đại diện Javis khi ghi dữ liệu (audit log, ownerId) — tự tạo nếu chưa có.
JAVIS_MCP_ACTOR_EMAIL=javis@vimove.internal

# Ad tracking pixels — site công khai (app/(public)/) — rỗng = không render script đó
# (tránh tag gãy). Điền sau khi tạo tài khoản/pixel thật, không cần sửa code.
# Meta (Facebook) Pixel ID — Trình quản lý sự kiện > Nguồn dữ liệu > Pixel.
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Pixel ID — TikTok Ads Manager > Assets > Events > Web Events.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Google Analytics 4 Measurement ID (dạng G-XXXXXXXXXX) — GA4 Admin > Data Streams.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
